{
  "name": "vscode-plugin-cottage",
  "displayName": "Cottage",
  "description": "Install cottage with the best available registry and configure VS Code agent safety hooks that block direct ctg use and secret file access.",
  "version": "0.0.8",
  "publisher": "sayanarijit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sayanarijit/vscode-plugin-cottage.git"
  },
  "homepage": "https://github.com/sayanarijit/vscode-plugin-cottage",
  "bugs": {
    "url": "https://github.com/sayanarijit/vscode-plugin-cottage/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "main": "./src/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "cottage.encryptedFileViewer",
        "displayName": "Cottage Encrypted File",
        "selector": [
          {
            "filenamePattern": "*.cott.age"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "cottage.installAndSecureWorkspace",
        "title": "Cottage: Install And Secure Workspace",
        "category": "Cottage"
      },
      {
        "command": "cottage.secureWorkspace",
        "title": "Cottage: Add AI Safety Hooks",
        "category": "Cottage"
      },
      {
        "command": "cottage.encryptFile",
        "title": "Cottage: Encrypt File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "cottage.encryptFile",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "2_workspace@50"
        }
      ]
    }
  },
  "scripts": {
    "lint": "node --check src/extension.js"
  },
  "keywords": [
    "cottage",
    "secrets",
    "copilot",
    "hooks",
    "age"
  ]
}
